#!/bin/bash
#/ script/generate-readme updates documentation.
#/ - For projects with binaries, it updates the usage output in README.md.
#/ - Adds script descriptions to CONTRIBUTING.md.

set -e

CDPATH="" cd -- "$(dirname -- "$0")/.."

update_file_section() {
  file="$1"
  start_comment="$2"
  end_comment="$3"
  replacement="$4"

  python - "$file" "$start_comment" "$end_comment" "$replacement" <<'PY'
from pathlib import Path
import sys

file, start_comment, end_comment, replacement = sys.argv[1:]
content = Path(file).read_text()
start_idx = content.find(start_comment)
if start_idx == -1:
    print(f"start comment not found in {file}: {start_comment}", file=sys.stderr)
    sys.exit(1)
end_search_start = start_idx + len(start_comment)
end_idx = content.find(end_comment, end_search_start)
if end_idx == -1:
    print(f"end comment not found in {file}: {end_comment}", file=sys.stderr)
    sys.exit(1)

replacement = f"{start_comment}\n{replacement}\n{end_comment}"
updated = content[:start_idx] + replacement + content[end_idx + len(end_comment):]
Path(file).write_text(updated)
PY
}

if [ -f script/gqltesthandler ]; then
  USAGE_OUTPUT="
\`\`\`
$(COLUMNS=100 script/gqltesthandler --help)
\`\`\`
"
fi

update_file_section README.md '<!--- start usage output --->' '<!--- end usage output --->' "$USAGE_OUTPUT"

for f in script/*; do
  [ -f "$f" ] || continue
  SCRIPT_DESCRIPTIONS="$SCRIPT_DESCRIPTIONS
### $(basename "$f")

$(grep '^#/' "$f" | cut -c 4-)
"
done

update_file_section CONTRIBUTING.md '<!--- start script descriptions --->' '<!--- end script descriptions --->' "$SCRIPT_DESCRIPTIONS"
update_file_section .github/copilot-instructions.md '<!--- start AGENTS.md --->' '<!--- end AGENTS.md --->' "$(cat AGENTS.md)"
