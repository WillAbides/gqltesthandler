type Query {
  user(id: ID!): User
  node(id: ID!): Node
}

interface Node {
  id: ID!
}

type User implements Node {
  id: ID!
  name: String!
  email: String
  posts(first: Int, after: String): PostConnection!
}

type Post implements Node {
  id: ID!
  title: String!
  body: String!
  author: User!
}

type PostConnection {
  nodes: [Post!]!
  pageInfo: PageInfo!
}

type PageInfo {
  endCursor: String
  hasNextPage: Boolean!
}
