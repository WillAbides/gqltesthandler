package {{.PackageName}}

import (
	"net/http"
	"sync"
)

// TestHandler is a mock GraphQL HTTP handler for testing.
// Set expectations with Expect methods, then use as an http.Handler.
type TestHandler struct {
	tb      TB
	handler http.Handler

	mu     sync.Mutex
	served bool
{{range .Operations}}
	{{.ExpectationField}} expectResponses[{{.VariablesType}}, {{.ResultInterface}}]
{{- end}}
}

func (s *TestHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	s.handler.ServeHTTP(w, r)
}

// NewTestHandler creates a new TestHandler for use in tests.
func NewTestHandler(tb TB) *TestHandler {
	th := &TestHandler{tb: tb}
	th.handler = &testServer{tb: tb, handler: th}
	return th
}

// markServed records that the handler has processed a request. Once true,
// Reset and Reset<OpName> refuse to wipe state.
func (s *TestHandler) markServed() {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.served = true
}

// hasServed reports whether the handler has processed any request.
func (s *TestHandler) hasServed() bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.served
}

// Reset wipes all registered expectations and defaults on this handler and
// clears any pending cleanup errors so previously-unmet expectations will not
// fail the test. If the handler has already served at least one request, Reset
// records an error via tb.Errorf and leaves state untouched.
func (s *TestHandler) Reset() {
	if s.hasServed() {
		s.tb.Errorf("TestHandler.Reset called after handler has served at least one request")
		return
	}
{{- range .Operations}}
	s.{{.ExpectationField}}.clear()
{{- end}}
}

{{range .Operations -}}
{{$op := . -}}

// {{.ResultInterface}} is the result interface for the {{.Name}} operation.
type {{.ResultInterface}} interface {
	write{{.Name}}Result(w http.ResponseWriter, vars {{.VariablesType}}) error
}

type {{.LowercaseName}}DataResult struct {
	data {{.ResponseType}}
}

func (r {{.LowercaseName}}DataResult) write{{.Name}}Result(w http.ResponseWriter, _ {{.VariablesType}}) error {
	return writeGraphQLData(w, r.data)
}

type {{.LowercaseName}}ErrorResult struct {
	errors []GraphQLError
}

func (r {{.LowercaseName}}ErrorResult) write{{.Name}}Result(w http.ResponseWriter, _ {{.VariablesType}}) error {
	return writeGraphQLErrors(w, r.errors)
}

type {{.LowercaseName}}RawResult struct {
	fn func({{.VariablesType}}, http.ResponseWriter)
}

func (r {{.LowercaseName}}RawResult) write{{.Name}}Result(w http.ResponseWriter, vars {{.VariablesType}}) error {
	r.fn(vars, w)
	return nil
}

// {{.BuilderTypeName}} is a builder for setting the response of a {{.Name}} expectation.
type {{.BuilderTypeName}} struct {
	handler *TestHandler
	vars    {{.VariablesType}}
	opts    []ExpectOption
}

// Respond sets the expectation to return the given data.
func (b *{{.BuilderTypeName}}) Respond(data {{.ResponseType}}) {
	b.handler.{{.ExpectationField}}.expect(b.handler.tb, b.vars, nil, {{.LowercaseName}}DataResult{data: data}, b.opts...)
}

// RespondError sets the expectation to return GraphQL errors.
func (b *{{.BuilderTypeName}}) RespondError(errors ...GraphQLError) {
	b.handler.{{.ExpectationField}}.expect(b.handler.tb, b.vars, nil, {{.LowercaseName}}ErrorResult{errors: errors}, b.opts...)
}

// Handle sets the expectation to invoke a custom handler function. The
// function receives the variables registered with Expect{{.Name}}.
func (b *{{.BuilderTypeName}}) Handle(fn func({{.VariablesType}}, http.ResponseWriter)) {
	b.handler.{{.ExpectationField}}.expect(b.handler.tb, b.vars, nil, {{.LowercaseName}}RawResult{fn: fn}, b.opts...)
}

// Expect{{.Name}} sets up an expectation for the {{.Name}} operation.
func (s *TestHandler) Expect{{.Name}}(vars {{.VariablesType}}, opts ...ExpectOption) *{{.BuilderTypeName}} {
	return &{{.BuilderTypeName}}{
		handler: s,
		vars:    vars,
		opts:    opts,
	}
}

// {{.Name}}Default is a builder for setting the default response of a
// {{.Name}} operation. Defaults are used when no Expect{{.Name}} expectation
// matches an incoming request.
type {{.Name}}Default struct {
	handler *TestHandler
}

// Respond sets the default response data for {{.Name}}.
func (b *{{.Name}}Default) Respond(data {{.ResponseType}}) {
	b.handler.{{.ExpectationField}}.setDefault({{.LowercaseName}}DataResult{data: data})
}

// RespondError sets the default response to return GraphQL errors for {{.Name}}.
func (b *{{.Name}}Default) RespondError(errors ...GraphQLError) {
	b.handler.{{.ExpectationField}}.setDefault({{.LowercaseName}}ErrorResult{errors: errors})
}

// Handle sets the default response to invoke a custom handler function for
// {{.Name}}. The function receives the actual variables from the incoming
// request.
func (b *{{.Name}}Default) Handle(fn func({{.VariablesType}}, http.ResponseWriter)) {
	b.handler.{{.ExpectationField}}.setDefault({{.LowercaseName}}RawResult{fn: fn})
}

// Default{{.Name}} returns a builder for setting the default response for the
// {{.Name}} operation. The default is matched only when no Expect{{.Name}}
// expectation matches an incoming request. Defaults are infinitely callable
// and never fail at cleanup. Calling Default{{.Name}} replaces any previously
// registered default.
func (s *TestHandler) Default{{.Name}}() *{{.Name}}Default {
	return &{{.Name}}Default{handler: s}
}

// Reset{{.Name}} wipes all registered expectations and the default for the
// {{.Name}} operation, and clears any pending cleanup errors. If the handler
// has already served at least one request, Reset{{.Name}} records an error via
// tb.Errorf and leaves state untouched.
func (s *TestHandler) Reset{{.Name}}() {
	if s.hasServed() {
		s.tb.Errorf("TestHandler.Reset{{.Name}} called after handler has served at least one request")
		return
	}
	s.{{.ExpectationField}}.clear()
}

